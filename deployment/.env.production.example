# ==============================================================================
# Production Environment Variables Template
# Copy this to backend/.env on your production server.
# NEVER commit the actual .env file with real secrets to GitHub!
# ==============================================================================

# Application Environment Mode (Enables Swagger Docs hiding & security rules)
ENVIRONMENT=production

# Project Branding
PROJECT_NAME="NER Landslide Monitoring System API"

# Allowed Production Origins for CORS (Comma-separated)
ALLOWED_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"

# Strong JWT Secret Key (Generate with: openssl rand -hex 32)
AUTH_SECRET_KEY=change-this-to-a-very-secure-random-64-char-string-in-production

# Copernicus Data Space Ecosystem (CDSE) S3 Credentials (For Sentinel-1 SAR imagery)
CDSE_S3_ACCESS_KEY=your_copernicus_s3_access_key_here
CDSE_S3_SECRET_KEY=your_copernicus_s3_secret_key_here

# Database Configuration (Defaults to SQLite; supports PostgreSQL)
DATABASE_URL="sqlite:///./landslide_monitoring.db"
# For PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/ner_landslide_db"
