# ==============================================================================
# Git Ignore for NER Landslide Risk Monitoring Platform
# Prevents leaking secrets, database files, and huge dependency folders
# ==============================================================================

# Node / Frontend dependencies & build artifacts
frontend/node_modules/
frontend/dist/
frontend/.vite/
node_modules/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python & Virtual Environments (NEVER COMMIT)
backend/venv/
backend/env/
backend/.venv/
venv/
env/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/app/**/__pycache__/
backend/**/__pycache__/

# Private Secrets & Environment Variables (CRITICAL: NEVER COMMIT)
.env
.env.*
!.env.example
!.env.production.example
backend/.env
frontend/.env
*.env.local

# SQLite Databases (Contains user credentials & report hashes)
*.sqlite
*.sqlite3
*.db
backend/*.db
backend/landslide_monitoring.db

# Heavy Satellite Imagery Cache & Uploaded Photo Evidence
backend/data/satellite_cache/*
!backend/data/satellite_cache/.gitkeep
backend/data/field_reports/*
!backend/data/field_reports/.gitkeep

# Operating System & IDE junk
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
